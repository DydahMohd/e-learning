APP_ENV=development
APP_ORIGIN=http://localhost:8081
APP_TIMEZONE=Africa/Dar_es_Salaam
DB_TIME_ZONE=+03:00
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eac_academy
DB_USER=root
DB_PASSWORD=

# Set to 1 only when intentionally using the bundled local demo accounts.
DEMO_ACCOUNTS_ENABLED=0

# Password-reset delivery requires both Brevo values. Forum alerts additionally
# require FORUM_NOTIFY_EMAIL.
FORUM_NOTIFY_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EAC Statistics e-Learning

# Sessions are persistent until explicit logout; there is intentionally no SESSION_TTL.
